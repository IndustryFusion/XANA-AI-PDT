# Helmfile 1.x. Run from helm/: helmfile -e default apply

environments:
  default:
    values:
      - environment/default.yaml
  production:
    values:
      - environment/default.yaml
      - environment/production.yaml
  # Production with the settings of a local-and-IONOS cluster: a later file overrides an earlier one.
  localAndIonos:
    values:
      - environment/default.yaml
      - environment/production.yaml
      - environment/localAndIonos.yaml
  # A local cluster with the stand-in services in test/stand-ins.yaml. See README.md.
  local:
    values:
      - environment/default.yaml
      - environment/local.yaml
---
releases:
  - name: xana-pdt
    namespace: {{ .Values.namespace }}
    chart: ./charts/xana-pdt
    values:
      - values.yaml.gotmpl
