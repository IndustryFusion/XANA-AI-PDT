#
# Bridges the environment's settings to the chart's values, and reads what must not be
# committed from the shell.
image:
  registry: {{ .Values.imageRegistry }}
  tag: {{ .Values.imageTag | quote }}
  pullPolicy: {{ .Values.imagePullPolicy }}
config:
  LLM_PROVIDER: {{ .Values.llmProvider | quote }}
  LLM_MODEL: {{ .Values.llmModel | quote }}
  {{- with .Values.llmProviderName }}
  LLM_PROVIDER_NAME: {{ . | quote }}
  {{- end }}
  {{- with .Values.ollamaUrl }}
  OLLAMA_URL: {{ . | quote }}
  {{- end }}
  {{- with .Values.openaiBaseUrl }}
  OPENAI_BASE_URL: {{ . | quote }}
  {{- end }}
  {{- with (env "XANA_KEYCLOAK_URL" | default .Values.keycloakUrl) }}
  KEYCLOAK_URL: {{ . | quote }}
  {{- end }}
  KEYCLOAK_REALM: {{ .Values.keycloakRealm | quote }}
  KEYCLOAK_CLIENT_ID: {{ .Values.keycloakClientId | quote }}
  {{- with .Values.factoryId }}
  FACTORY_ID: {{ . | quote }}
  {{- end }}
  NGSI_URL: {{ .Values.ngsiUrl | quote }}
  {{- with .Values.ngsiContextUrl }}
  NGSI_CONTEXT_URL: {{ . | quote }}
  {{- end }}
  PGREST_URL: {{ .Values.pgrestUrl | quote }}
  {{- with .Values.gatewayUrl }}
  GATEWAY_URL: {{ . | quote }}
  {{- end }}
  {{- with .Values.gatewayKeycloakUrl }}
  GATEWAY_KEYCLOAK_URL: {{ . | quote }}
  {{- end }}
  GATEWAY_KEYCLOAK_REALM: {{ .Values.gatewayKeycloakRealm | quote }}
  {{- with .Values.gatewayClientId }}
  GATEWAY_CLIENT_ID: {{ . | quote }}
  {{- end }}
  DATA_SHARING_POLICY: {{ .Values.dataSharingPolicy | quote }}
  ALERTA_URL: {{ .Values.alertaUrl | quote }}
  ALERTS_REFRESH_INTERVAL_S: {{ .Values.alertsRefreshIntervalS | quote }}
  FUSEKI_URL: {{ .Values.fusekiUrl | quote }}
  FUSEKI_DATASET: {{ .Values.fusekiDataset | quote }}
  {{- with .Values.fusekiGraphBase }}
  FUSEKI_GRAPH_BASE: {{ . | quote }}
  {{- end }}
  MQTT_BROKER_URL: {{ .Values.mqttBrokerUrl | quote }}
  MQTT_MGMT_URL: {{ .Values.mqttMgmtUrl | quote }}
  {{- with .Values.mqttBrokerNotifyUrl }}
  MQTT_BROKER_NOTIFY_URL: {{ . | quote }}
  {{- end }}
  POSTGRES_SSLMODE: {{ .Values.postgresSslMode | quote }}
  {{- range $name, $value := .Values.extraConfig }}
  {{ $name }}: {{ $value | quote }}
  {{- end }}
database:
  host: {{ .Values.databaseHost }}
  port: {{ .Values.databasePort }}
  credentialsSecret: {{ .Values.databaseCredentialsSecret | quote }}
  caCert:
    secret: {{ .Values.databaseCaSecret | quote }}
secrets:
  existingSecret: {{ env "XANA_EXISTING_SECRET" | default .Values.existingSecret | quote }}
  values:
    {{- with env "XANA_ANTHROPIC_API_KEY" }}
    ANTHROPIC_API_KEY: {{ . | quote }}
    {{- end }}
    {{- with env "XANA_OPENAI_API_KEY" }}
    OPENAI_API_KEY: {{ . | quote }}
    {{- end }}
    {{- with env "XANA_ALERTA_API_KEY" }}
    ALERTA_API_KEY: {{ . | quote }}
    {{- end }}
    {{- with env "XANA_GATEWAY_CLIENT_SECRET" }}
    GATEWAY_CLIENT_SECRET: {{ . | quote }}
    {{- end }}
    {{- with env "XANA_SETTINGS_ENCRYPTION_KEY" }}
    SETTINGS_ENCRYPTION_KEY: {{ . | quote }}
    {{- end }}
    {{- with env "XANA_LANGFUSE_PUBLIC_KEY" }}
    LANGFUSE_PUBLIC_KEY: {{ . | quote }}
    {{- end }}
    {{- with env "XANA_LANGFUSE_SECRET_KEY" }}
    LANGFUSE_SECRET_KEY: {{ . | quote }}
    {{- end }}
ingress:
  enabled: {{ .Values.ingressEnabled }}
  className: {{ .Values.ingressClass | quote }}
  host: {{ env "XANA_INGRESS_HOST" | default .Values.ingressHost | quote }}
  tlsSecret: {{ .Values.ingressTlsSecret | quote }}
  {{- if eq .Values.ingressClass "nginx" }}
  annotations:
    nginx.ingress.kubernetes.io/proxy-read-timeout: "300"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "300"
    nginx.ingress.kubernetes.io/proxy-body-size: 64m
  {{- else }}
  annotations: null
  {{- end }}
