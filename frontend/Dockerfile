# The UI on the backend data source, served by nginx. nginx also forwards API and
# stream requests to XANA_BACKEND_URL, so a browser needs only this address.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.js ./
COPY src ./src
ENV VITE_DATA_SOURCE=backend
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
ENV XANA_BACKEND_URL=http://backend:8000
EXPOSE 8080
