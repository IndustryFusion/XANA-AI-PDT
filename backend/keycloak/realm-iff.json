{
  "realm": "iff",
  "enabled": true,
  "accessTokenLifespan": 300,
  "roles": {
    "client": {
      "scorpio": [
        { "name": "Factory-Admin" },
        { "name": "Factory-Reader" }
      ]
    }
  },
  "clients": [
    {
      "clientId": "scorpio",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "pgrest role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "role",
            "claim.value": "dbreader",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "ifric company",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "ifric_company_id",
            "claim.value": "urn:ifric:company:sample",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "ifric factory",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "ifric_factory_id",
            "claim.value": "urn:ifric:factory:sample",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sample",
      "lastName": "Operator",
      "email": "operator@example.org",
      "clientRoles": { "scorpio": ["Factory-Admin"] },
      "credentials": [
        {
          "type": "password",
          "value": "operator"
        }
      ]
    }
  ]
}
