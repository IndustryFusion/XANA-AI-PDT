# XANA AI PDT backend configuration.
# Copy to backend/.env for local development. Every variable is optional
# unless noted; the value shown is the default. Never commit real secrets.

# --- Language model -----------------------------------------------------------
# Provider: ollama | anthropic | openai | scripted (fixed answers, no model).
LLM_PROVIDER=ollama
# Model name for the chosen provider.
LLM_MODEL=llama3.1
# Local Ollama server.
OLLAMA_URL=http://localhost:11434
# Secret. Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Secret. Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Optional base URL for OpenAI-compatible servers.
OPENAI_BASE_URL=
# Timeout of one model call, in seconds.
LLM_TIMEOUT_S=120

# --- Agent behaviour ------------------------------------------------------------
# Runs below this decision confidence (0 to 1) ask the operator for more information.
DECISION_CONFIDENCE_THRESHOLD=0.9
# Analysis rounds that run at the same time; further rounds wait in status running.
MAX_CONCURRENT_ROUNDS=2

# --- Data sources ---------------------------------------------------------------
# NGSI-LD context broker.
NGSI_URL=http://localhost:9090
# Optional NGSI-LD tenant (NGSILD-Tenant header).
NGSI_TENANT=
# Time-series store (TimescaleDB). May contain a password; it is never shown.
TIMESCALE_DB_URL=postgresql://xana@localhost:5432/tsdb
# Attribute history table in the time-series store.
TIMESCALE_TABLE=attributes
# Incident memory (PostgreSQL). May contain a password; it is never shown.
POSTGRES_MEMORY_URL=postgresql://xana@localhost:5432/memory

# --- Health report --------------------------------------------------------------
# Timeout per dependency check, in seconds.
HEALTH_TIMEOUT_S=3
# A health report is reused for this many seconds unless a fresh check is requested.
HEALTH_CACHE_S=10

# --- Server ---------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Reload on code changes (development only).
BACKEND_RELOAD=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
