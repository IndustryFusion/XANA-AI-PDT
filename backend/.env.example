# XANA AI PDT backend configuration.
# Copy to backend/.env for local development. Every variable is optional
# unless noted; the value shown is the default. Never commit real secrets.

# --- Language model -----------------------------------------------------------
# Provider: ollama | anthropic | openai | scripted (fixed answers, no model: one question,
# then a diagnosis once the operator has clarified).
LLM_PROVIDER=ollama
# Model name for the chosen provider.
LLM_MODEL=llama3.1
# Local Ollama server.
OLLAMA_URL=http://localhost:11434
# Secret. Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Secret. Required when LLM_PROVIDER=openai, unless OPENAI_BASE_URL is set.
OPENAI_API_KEY=
# Optional base URL for OpenAI-compatible servers: OpenVINO Model Server
# (for example http://ovms:8000/v3), IONOS and others. Use with LLM_PROVIDER=openai.
OPENAI_BASE_URL=
# Name operators see for the provider, for example OpenVINO. Defaults to LLM_PROVIDER.
LLM_PROVIDER_NAME=
# Context size given to Ollama, in tokens. Long prompts are cut off above this size.
LLM_NUM_CTX=32768
# Timeout of one model call, in seconds.
LLM_TIMEOUT_S=120

# --- Tracing (optional; needs the `tracing` extra, otherwise it stays off) --------
# Traces model calls with their run in Langfuse. Set both keys to turn it on.
LANGFUSE_PUBLIC_KEY=
# Secret.
LANGFUSE_SECRET_KEY=
# Langfuse server. Empty uses Langfuse's default.
LANGFUSE_HOST=

# --- Agent behaviour ------------------------------------------------------------
# Runs below this decision confidence (0 to 1) ask the operator for more information.
DECISION_CONFIDENCE_THRESHOLD=0.9
# Analysis rounds that run at the same time; further rounds wait in status running.
MAX_CONCURRENT_ROUNDS=2

# --- Sign-in ----------------------------------------------------------------------
# Keycloak address, for example https://keycloak.example.org/auth. Empty turns sign-in off.
# Tokens are requested here, so it must match the issuer that services check.
KEYCLOAK_URL=
KEYCLOAK_REALM=iff
# A public client with direct access grants.
KEYCLOAK_CLIENT_ID=scorpio
# Factory shown when the token has no ifric_factory_id claim.
FACTORY_ID=

# --- Data sources ---------------------------------------------------------------
# NGSI-LD context broker.
NGSI_URL=http://localhost:9090
# Optional NGSI-LD tenant (NGSILD-Tenant header).
NGSI_TENANT=
# Time-series store (TimescaleDB). May contain a password; it is never shown.
TIMESCALE_DB_URL=postgresql://xana@localhost:5432/tsdb
# Attribute history table in the time-series store.
TIMESCALE_TABLE=attributes
# Incident memory (PostgreSQL). May contain a password; it is never shown.
POSTGRES_MEMORY_URL=postgresql://xana@localhost:5432/memory

# Database TLS, applied to both database URLs unless a URL already states it.
# disable | allow | prefer | require | verify-ca | verify-full
POSTGRES_SSLMODE=
# Root certificate file, for verify-ca and verify-full.
POSTGRES_SSLROOTCERT=

# --- Health report --------------------------------------------------------------
# Timeout per dependency check, in seconds.
HEALTH_TIMEOUT_S=3
# A health report is reused for this many seconds unless a fresh check is requested.
HEALTH_CACHE_S=10

# --- Server ---------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Reload on code changes (development only).
BACKEND_RELOAD=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
