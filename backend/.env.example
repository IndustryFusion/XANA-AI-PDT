# XANA AI PDT backend configuration.
# Copy to backend/.env for local development. Every variable is optional
# unless noted; the value shown is the default. Never commit real secrets.

# --- Language model -----------------------------------------------------------
# Provider: ollama | anthropic | openai | scripted (fixed answers, no model: one question,
# then a diagnosis once the operator has clarified).
LLM_PROVIDER=ollama
# Model name for the chosen provider.
LLM_MODEL=llama3.1
# Local Ollama server.
OLLAMA_URL=http://localhost:11434
# Secret. Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Secret. Required when LLM_PROVIDER=openai, unless OPENAI_BASE_URL is set.
OPENAI_API_KEY=
# Optional base URL for OpenAI-compatible servers: OpenVINO Model Server
# (for example http://ovms:8000/v3), IONOS and others. Use with LLM_PROVIDER=openai.
OPENAI_BASE_URL=
# Name operators see for the provider, for example OpenVINO. Defaults to LLM_PROVIDER.
LLM_PROVIDER_NAME=
# Context size given to Ollama, in tokens. Long prompts are cut off above this size.
LLM_NUM_CTX=32768
# Timeout of one model call, in seconds.
LLM_TIMEOUT_S=120

# --- Tracing (optional; needs the `tracing` extra, otherwise it stays off) --------
# Traces model calls with their run in Langfuse. Set both keys to turn it on.
LANGFUSE_PUBLIC_KEY=
# Secret.
LANGFUSE_SECRET_KEY=
# Langfuse server, such as your own. Empty uses Langfuse's default. LANGFUSE_BASE_URL is the same setting
# under its newer name; set one, or the same address in both.
LANGFUSE_HOST=
LANGFUSE_BASE_URL=

# --- Agent behaviour ------------------------------------------------------------
# Runs below this decision confidence (0 to 1) ask the operator for more information.
DECISION_CONFIDENCE_THRESHOLD=0.9
# Analysis rounds that run at the same time; further rounds wait in status running.
MAX_CONCURRENT_ROUNDS=2
# Finished runs (completed, failed, stopped, closed by the machine builder) with no change for this many
# seconds move to incident history by themselves. A run whose close is still to go out stays. 0 turns it off.
AUTO_ARCHIVE_AFTER_S=3600

# --- Sign-in ----------------------------------------------------------------------
# Keycloak address, for example https://keycloak.example.org/auth. Empty turns sign-in off.
# Tokens are requested here, so it must match the issuer that services check.
KEYCLOAK_URL=
KEYCLOAK_REALM=iff
# A public client with direct access grants.
KEYCLOAK_CLIENT_ID=scorpio
# Factory shown when the token has no ifric_factory_id claim.
FACTORY_ID=
# A confidential client with a service account, used for machine events and the runs they start,
# so that they work with nobody signed in. Set both, with KEYCLOAK_URL. Empty uses the signed-in operator.
KEYCLOAK_SERVICE_CLIENT_ID=
# Secret.
KEYCLOAK_SERVICE_CLIENT_SECRET=

# --- Machine events ----------------------------------------------------------------
# The backend as the context broker reaches it. Empty means no subscription.
CALLBACK_BASE_URL=
# What the subscription watches. Short names are read under NGSI_CONTEXT_URL, and can be full IRIs. `status` is a
# term of the NGSI-LD core context, which wins over another context, so on data with full IRIs name it in full.
MACHINE_WATCH_TYPE=Machine
MACHINE_WATCH_ATTRIBUTES=status,errorCode,alarmLevel,faultCode
# Secret. What callers of /events/* present as a bearer token. Empty refuses every call. Required with
# CALLBACK_BASE_URL. Anyone who may read subscriptions from the broker can read it.
EVENT_WEBHOOK_SECRET=

# --- Data sources ---------------------------------------------------------------
# NGSI-LD context broker.
NGSI_URL=http://localhost:9090
# Optional NGSI-LD tenant (NGSILD-Tenant header).
NGSI_TENANT=
# JSON-LD context sent as a Link header. Needed for short names when attributes are full IRIs,
# as on the platform: without it a query by short name silently finds nothing.
NGSI_CONTEXT_URL=
# Comma-separated addresses of JSON-LD contexts that imported entities may name, as the broker fetches
# them from inside the platform, unchecked. NGSI_CONTEXT_URL and the ETSI core context are always allowed.
NGSI_ALLOWED_CONTEXTS=
# PostgREST on the time-series store, for the explorer's history and time-shift.
PGREST_URL=http://pgrest:3000
# Time-series store (TimescaleDB). May contain a password; it is never shown.
TIMESCALE_DB_URL=postgresql://xana@localhost:5432/tsdb
# Attribute history table in the time-series store.
TIMESCALE_TABLE=attributes
# Entity lifecycle table in the time-series store.
TIMESCALE_ENTITY_TABLE=entities
# Incident memory (PostgreSQL). May contain a password; it is never shown.
POSTGRES_MEMORY_URL=postgresql://xana@localhost:5432/memory

# Database TLS, applied to both database URLs unless a URL already states it.
# disable | allow | prefer | require | verify-ca | verify-full
POSTGRES_SSLMODE=
# Root certificate file, for verify-ca and verify-full.
POSTGRES_SSLROOTCERT=

# --- Alerts ------------------------------------------------------------------------
# Alerta's API. Must end in /api.
ALERTA_URL=http://alerta:8080/api
# Secret. Sent as `Authorization: Key <key>`.
ALERTA_API_KEY=
# Automatic refresh of the Alerts screen, in seconds, until the operator chooses another.
ALERTS_REFRESH_INTERVAL_S=30

# --- Dataspace ---------------------------------------------------------------------
# The dataspace's API gateway. Empty means no dataspace: escalation is not available.
GATEWAY_URL=
# Keycloak of the dataspace, as the gateway knows it: tokens have to be issued through this address.
GATEWAY_KEYCLOAK_URL=
GATEWAY_KEYCLOAK_REALM=dataspace
# The participant's client. An operator's `ifric_company_id` claim comes first.
GATEWAY_CLIENT_ID=
# Secret. Optional: the operator can enter it on the Dataspace screen. Stored encrypted.
GATEWAY_CLIENT_SECRET=
# Secret. Encrypts the stored client secret; required with GATEWAY_URL.
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SETTINGS_ENCRYPTION_KEY=
# What an escalation may share: minimal | adjacent | timeseries
DATA_SHARING_POLICY=minimal
# How often the dataspace's inbox is read, in seconds.
INBOX_POLL_INTERVAL_S=15

# --- IFRIC registry ----------------------------------------------------------------
# Company names, machine builders and factories, including the port (the registry's default is 4007).
# Asked with the dataspace token. Empty means none.
IFRIC_URL=

# --- Ontology ----------------------------------------------------------------------
# Fuseki, with the machine ontology and SHACL shapes. Gives the explorer its value hints.
FUSEKI_URL=http://fuseki:3030
# Its dataset; on the platform, named after the realm.
FUSEKI_DATASET=iff
# What graph names start with: <base>/shacl.ttl and <base>/knowledge.ttl. On the platform
# http://<Fuseki's external host>/<realm>. Empty uses FUSEKI_URL/FUSEKI_DATASET.
FUSEKI_GRAPH_BASE=

# --- Live updates in the Data Explorer ---------------------------------------------
# The MQTT broker, as the backend reaches it.
MQTT_BROKER_URL=mqtt://emqx-listeners:1883
# The MQTT broker's management interface, to tell why it can't be reached.
MQTT_MGMT_URL=http://emqx-dashboard:18083
# The MQTT broker, as the context broker reaches it. Empty uses MQTT_BROKER_URL.
MQTT_BROKER_NOTIFY_URL=

# Comma-separated origins of web pages that may open the live updates stream, besides the
# backend's own, for a UI served from another address. For example https://ui.example.org
WS_ALLOWED_ORIGINS=

# --- Health report --------------------------------------------------------------
# Timeout per dependency check, in seconds.
HEALTH_TIMEOUT_S=3
# A health report is reused for this many seconds unless a fresh check is requested.
HEALTH_CACHE_S=10

# --- Server ---------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Reload on code changes (development only).
BACKEND_RELOAD=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
