# Sample SHACL shapes for the sample machines, in the form the platform's shapes have.
@prefix : <https://example.org/shapes/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ngsi-ld: <https://uri.etsi.org/ngsi-ld/> .
@prefix base: <https://uri.etsi.org/ngsi-ld/default-context/> .

:equipmentStatus a sh:NodeShape ;
    sh:targetClass base:Equipment ;
    sh:property [
        sh:path base:status ;
        sh:nodeKind sh:BlankNode ;
        sh:property [
            sh:path ngsi-ld:hasValue ;
            sh:in ( "running" "idle" "setup" "maintenance" "fault" ) ;
        ] ;
    ] .

:machineMode a sh:NodeShape ;
    sh:targetClass base:Machine ;
    sh:property [
        sh:path base:operatingMode ;
        sh:nodeKind sh:BlankNode ;
        sh:property [
            sh:path ngsi-ld:hasValue ;
            sh:class base:OperatingMode ;
        ] ;
    ] ;
    sh:property [
        sh:path base:machineType ;
        sh:nodeKind sh:BlankNode ;
        sh:property [
            sh:path ngsi-ld:hasValue ;
            sh:datatype xsd:string ;
        ] ;
    ] .

:sensorValue a sh:NodeShape ;
    sh:targetClass base:Sensor ;
    sh:property [
        sh:path base:value ;
        sh:nodeKind sh:BlankNode ;
        sh:property [
            sh:path ngsi-ld:hasValue ;
            sh:datatype xsd:double ;
            sh:minInclusive -40.0 ;
            sh:maxExclusive 1000.0 ;
        ] ;
    ] .

:lineShifts a sh:NodeShape ;
    sh:targetClass base:ProductionLine ;
    sh:property [
        sh:path base:shifts ;
        sh:nodeKind sh:BlankNode ;
        sh:property [
            sh:path ngsi-ld:hasValueList ;
            sh:in ( "early" "late" "night" ) ;
        ] ;
    ] .
