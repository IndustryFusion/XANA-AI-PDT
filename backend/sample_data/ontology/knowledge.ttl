# Sample knowledge for the sample machines: classes, and the individuals of a class.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix base: <https://uri.etsi.org/ngsi-ld/default-context/> .
@prefix mode: <https://example.org/operating-mode/> .

base:Equipment a owl:Class .
base:Machine a owl:Class ;
    rdfs:subClassOf base:Equipment .
base:Component a owl:Class ;
    rdfs:subClassOf base:Equipment .
base:Sensor a owl:Class .
base:ProductionLine a owl:Class .

base:OperatingMode a owl:Class .
mode:automatic a base:OperatingMode .
mode:manual a base:OperatingMode .
mode:setup a base:OperatingMode .
mode:maintenance a base:OperatingMode .
